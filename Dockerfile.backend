# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
RUN --mount=type=cache,target=/root/.npm \
  npm ci --prefer-offline --no-audit

COPY apps/backend ./apps/backend
COPY docker/backend-entrypoint.sh ./docker/backend-entrypoint.sh

# Normalize Windows checkout line endings before running the Linux entrypoint.
RUN sed -i 's/\r$//' docker/backend-entrypoint.sh \
  && npm run prisma:generate \
  && npm run build:backend

EXPOSE 4000

CMD ["sh", "docker/backend-entrypoint.sh"]
