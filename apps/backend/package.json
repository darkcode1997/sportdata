{
  "name": "@sportdata/backend",
  "version": "1.0.0",
  "private": true,
  "description": "SportData Platform Backend API",
  "scripts": {
    "build": "nest build",
    "vercel-build": "node scripts/prepare-vercel-build.cjs && prisma generate && nest build && node scripts/vercel-storage-deploy.cjs",
    "storage:migrate:r2": "node scripts/migrate-storage-r2.cjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:constraints": "prisma db execute --schema prisma/schema.prisma --file prisma/sql/match-schedule-constraints.sql",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "seed:demo-accounts": "ts-node prisma/seed-demo-accounts.ts",
    "seed:domestic-centers": "ts-node prisma/seed-domestic-centers.ts",
    "seed:national-jujitsu": "ts-node prisma/seed-national-jujitsu.ts",
    "seed:sea-games:verify": "ts-node prisma/verify-sea-games-seed.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.9.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/schematics": "^10.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "prisma": "^5.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
