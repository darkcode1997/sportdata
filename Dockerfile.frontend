FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
RUN npm ci

COPY apps/frontend ./apps/frontend
# The frontend re-exports the shared ticket layout contract from the backend.
# Keep that source available in the frontend build image as well.
COPY apps/backend/src/events/ticket-design.ts ./apps/backend/src/events/ticket-design.ts

ARG API_INTERNAL_URL=http://backend:4000/api
ARG IMAGE_HOSTNAMES=images.unsplash.com,flagcdn.com
ENV NEXT_PUBLIC_API_URL=$API_INTERNAL_URL
ENV IMAGE_HOSTNAMES=$IMAGE_HOSTNAMES
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build:frontend

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=@sportdata/frontend"]
