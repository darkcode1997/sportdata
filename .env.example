# Local: sao chép thành .env. Docker chạy một backend và một frontend.
# Production: sao chép thành .env.production, thay các giá trị replace-with-*
# và JWT_SECRET, rồi dùng docker-compose.production.yml với --env-file .env.production.

# ===============================
# Database - PostgreSQL
# ===============================
# Dùng khi chạy backend bằng npm với PostgreSQL cài trên máy.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sportdata?schema=public"
# Nếu backend chạy bằng npm và PostgreSQL chạy bằng Docker local, dùng:
# DATABASE_URL="postgresql://sportdata:sportdata@localhost:5433/sportdata?schema=public"

# ===============================
# Docker local - cổng trên máy chủ
# ===============================
POSTGRES_HOST_PORT="5433"
BACKEND_HOST_PORT="4000"
FRONTEND_HOST_PORT="3000"
# Compose tự đặt URL nội bộ: postgres:5432, backend:4000 và frontend:3000.
# Nếu đổi cổng và chạy ứng dụng bằng npm, cập nhật các URL localhost tương ứng.

# ===============================
# Docker production - một backend, một frontend sau Nginx
# ===============================
# Chỉ dùng trong docker-compose.production.yml; PUBLIC_DOMAIN không gồm https://.
PUBLIC_DOMAIN="replace-with-your-domain"
IMAGE_TAG="latest"
POSTGRES_DB="sportdata"
POSTGRES_USER="sportdata"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"
# PostgreSQL replica và backup vẫn dùng mật khẩu riêng này.
POSTGRES_REPLICATION_PASSWORD="replace-with-a-strong-replication-password"
BACKUP_RETENTION_DAYS="14"
GRAFANA_ADMIN_PASSWORD="replace-with-a-strong-grafana-password"
IMAGE_HOSTNAMES="images.unsplash.com,flagcdn.com"
# Production Compose tự đặt URL HTTPS từ PUBLIC_DOMAIN và DATABASE_URL nội bộ.

# ===============================
# Backend (NestJS)
# ===============================
PORT=4000
FRONTEND_URL="http://localhost:3000"
# Danh sách origin phân tách bằng dấu phẩy; hữu ích cho production + preview Vercel.
FRONTEND_URLS="http://localhost:3000"
ALLOW_VERCEL_PREVIEWS="false"
BACKEND_PUBLIC_URL="http://localhost:4000"
JWT_SECRET="sportdata-super-secret-key-change-in-production-please-change-this-123456"
JWT_EXPIRES_IN="7d"
RATE_LIMIT_TTL_MS="60000"
RATE_LIMIT_REQUESTS="120"

# ===============================
# File storage: local | cloudinary | s3 | r2
# ===============================
# PostgreSQL chỉ lưu metadata/định danh; config này chọn nơi lưu file mới.
STORAGE_DRIVER="local"
# Đường dẫn tương đối tính từ thư mục chạy backend (npm workspace: apps/backend).
# Docker local/production tự đặt /app/storage, mount volume sportdata_storage.
STORAGE_LOCAL_DIR="static/uploads"
STORAGE_TIMEOUT_MS="30000"

# Cloudinary: file được lưu authenticated, backend đọc qua URL ký nội bộ.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Resize khi upload: giữ tỷ lệ, chỉ thu nhỏ, kích thước tính theo pixel.
CLOUDINARY_RESIZE_ENABLED="true"
CLOUDINARY_IMAGE_MAX_WIDTH="1920"
CLOUDINARY_IMAGE_MAX_HEIGHT="1920"
CLOUDINARY_AVATAR_MAX_WIDTH="800"
CLOUDINARY_AVATAR_MAX_HEIGHT="1200"
CLOUDINARY_DOCUMENT_MAX_WIDTH="2400"
CLOUDINARY_DOCUMENT_MAX_HEIGHT="2400"
# auto:good hoặc 1-100; để trống nếu không muốn tối ưu chất lượng.
CLOUDINARY_IMAGE_QUALITY="auto:good"
# S3 hoặc dịch vụ tương thích S3; endpoint để trống khi dùng AWS S3.
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_FORCE_PATH_STYLE="false"

# Cloudflare R2: dùng S3 API credentials của token R2 Object Read & Write.
STORAGE_R2_BUCKET=""
STORAGE_R2_ACCOUNT_ID=""
# Để trống để suy ra từ ACCOUNT_ID; điền S3 API endpoint nếu bucket có jurisdiction.
STORAGE_R2_ENDPOINT=""
STORAGE_R2_ACCESS_KEY_ID=""
STORAGE_R2_SECRET_ACCESS_KEY=""
# Additional trusted HTTPS image hosts when migrating existing URL images.
STORAGE_MIGRATION_ALLOWED_HOSTS="images.unsplash.com,res.cloudinary.com,upload.wikimedia.org,flagcdn.com"
# Optional local directory containing old public images; migrate local files before Vercel deployment.
STORAGE_LEGACY_PUBLIC_DIR=""
# Marketing email uses SMTP settings and FRONTEND_URL. CMS can override this switch.
MARKETING_EMAIL_ENABLED=true
# Set a random secret for the authenticated marketing cron endpoint in production.
CRON_SECRET=
# One-click unsubscribe uses BACKEND_PUBLIC_URL above, or the FRONTEND_URL /api rewrite.

# Parallel file transfers during migration (1-8). Files are verified before updating references.
STORAGE_MIGRATION_CONCURRENCY=4

# ===============================
# File storage: local | cloudinary | s3 | r2
# ===============================
# PostgreSQL chỉ lưu metadata/định danh; config này chọn nơi lưu file mới.
STORAGE_DRIVER="local"
# Đường dẫn tương đối tính từ thư mục chạy backend (npm workspace: apps/backend).
# Dùng đường dẫn tuyệt đối khi chạy nhiều backend hoặc dùng Docker.
STORAGE_LOCAL_DIR="static/uploads"
STORAGE_TIMEOUT_MS="30000"

# Cloudinary: file được lưu authenticated, backend đọc qua URL ký nội bộ.
CLOUDINARY_CLOUD_NAME="@"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Resize khi upload: giữ tỷ lệ, chỉ thu nhỏ, kích thước tính theo pixel.
CLOUDINARY_RESIZE_ENABLED="true"
CLOUDINARY_IMAGE_MAX_WIDTH="1920"
CLOUDINARY_IMAGE_MAX_HEIGHT="1920"
CLOUDINARY_AVATAR_MAX_WIDTH="800"
CLOUDINARY_AVATAR_MAX_HEIGHT="1200"
CLOUDINARY_DOCUMENT_MAX_WIDTH="2400"
CLOUDINARY_DOCUMENT_MAX_HEIGHT="2400"
# auto:good hoặc 1-100; để trống nếu không muốn tối ưu chất lượng.
CLOUDINARY_IMAGE_QUALITY="auto:good"
# S3 hoặc dịch vụ tương thích S3; endpoint để trống khi dùng AWS S3.
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_FORCE_PATH_STYLE="false"

# Cloudflare R2: dùng S3 API credentials của token R2 Object Read & Write.
STORAGE_R2_BUCKET=""
STORAGE_R2_ACCOUNT_ID=""
# Để trống để suy ra từ ACCOUNT_ID; điền S3 API endpoint nếu bucket có jurisdiction.
STORAGE_R2_ENDPOINT=""
STORAGE_R2_ACCESS_KEY_ID=""
STORAGE_R2_SECRET_ACCESS_KEY=""

# ===============================
# CMS administrator
# ===============================
ADMIN_EMAIL="admin@sportdata.vn"
ADMIN_USERNAME="admin"
ADMIN_NAME="SportData Administrator"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_ROLE="ADMIN"
ADMIN_SYNC_PASSWORD="false"
# Chỉ nạp dữ liệu mẫu khi chủ động bật seed; production Compose luôn tắt seed.
SEED_DATABASE="false"
SEED_SEA_GAMES_DEMO="false"

# ===============================
# Password recovery (SMTP optional in local development)
# ===============================
PASSWORD_RESET_TTL_MINUTES="30"
PAYMENT_SESSION_TTL_MINUTES="30"
UNPAID_REGISTRATION_TTL_HOURS="24"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SportData <your-smtp-account@gmail.com>"
TICKET_EMAIL_ENABLED="true"

# OCR CCCD/hộ chiếu. false = bỏ qua OCR, vẫn lưu ảnh và chuyển CMS kiểm duyệt thủ công.
IDENTITY_OCR_ENABLED="false"
# Khi bật IDENTITY_OCR_ENABLED=true, cấu hình khóa và endpoint FPT.AI bên dưới.
FPT_AI_API_KEY=""
FPT_AI_ID_ENDPOINT="https://api.fpt.ai/vision/idr/vnm/"
FPT_AI_PASSPORT_ENDPOINT="https://api.fpt.ai/vision/passport/vnm"

# ===============================
# Payment gateways
# ===============================
# Giữ false cho đến khi có tài khoản merchant và callback HTTPS công khai.
PAYMENTS_ENABLED="true"
BANK_QR_ENABLED="true"
MOMO_ENABLED="false"
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_API_URL="https://test-payment.momo.vn"
MOMO_PARTNER_NAME="SportData"
MOMO_STORE_ID="SportData"

VNPAY_ENABLED="false"
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# ===============================
# Frontend (Next.js)
# ===============================
API_INTERNAL_URL="http://localhost:4000/api"
# Để trống khi local/Docker (frontend dùng /api rewrite). Trên Vercel đặt URL API công khai.
NEXT_PUBLIC_BROWSER_API_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Stable key for encrypted CMS integration secrets (at least 32 random characters).
# If empty, a non-default JWT_SECRET with at least 32 characters is used.
# Keep this key when restoring backups; changing it requires re-entering stored secrets.
SETTINGS_ENCRYPTION_KEY=
